// Polynôme de Chebyshev de première espèce
vector<complex128> generate_chebyshev_polynomial(int n) {
    if (n == 0) return {1.0};
    if (n == 1) return {1.0, 0.0}; // x
    
    vector<complex128> T0 = {1.0};                     // T0(x) = 1
    vector<complex128> T1 = {1.0, 0.0};               // T1(x) = x
    
    for (int i = 2; i <= n; i++) {
        // Tn(x) = 2x*T_{n-1}(x) - T_{n-2}(x)
        vector<complex128> Tn(T1.size() + 1, 0.0);
        
        // 2x * T_{n-1}(x)
        for (size_t j = 0; j < T1.size(); j++) {
            Tn[j + 1] += 2.0 * T1[j];
        }
        
        // - T_{n-2}(x)
        for (size_t j = 0; j < T0.size(); j++) {
            Tn[j] -= T0[j];
        }
        
        T0 = T1;
        T1 = Tn;
    }
    
    return T1;
}

// Polynôme de Legendre
vector<complex128> generate_legendre_polynomial(int n) {
    if (n == 0) return {1.0};
    if (n == 1) return {1.0, 0.0}; // x
    
    vector<complex128> P0 = {1.0};                     // P0(x) = 1
    vector<complex128> P1 = {1.0, 0.0};               // P1(x) = x
    
    for (int i = 2; i <= n; i++) {
        // Pn(x) = [(2n-1)x*P_{n-1}(x) - (n-1)P_{n-2}(x)] / n
        vector<complex128> Pn(P1.size() + 1, 0.0);
        
        // (2n-1)x * P_{n-1}(x)
        for (size_t j = 0; j < P1.size(); j++) {
            Pn[j + 1] += (2.0*i - 1.0) * P1[j];
        }
        
        // - (n-1)P_{n-2}(x)
        for (size_t j = 0; j < P0.size(); j++) {
            Pn[j] -= (i - 1.0) * P0[j];
        }
        
        // / n
        for (size_t j = 0; j < Pn.size(); j++) {
            Pn[j] /= i;
        }
        
        P0 = P1;
        P1 = Pn;
    }
    
    return P1;
}

// Polynôme de Laguerre
vector<complex128> generate_laguerre_polynomial(int n, double alpha = 0.0) {
    if (n == 0) return {1.0};
    if (n == 1) return {1.0 + alpha, -1.0}; // (α+1) - x
    
    vector<complex128> L0 = {1.0};                     // L0(x) = 1
    vector<complex128> L1 = {1.0 + alpha, -1.0};      // L1(x) = (α+1) - x
    
    for (int i = 2; i <= n; i++) {
        // Ln(x) = [(2n-1+α-x)L_{n-1}(x) - (n-1+α)L_{n-2}(x)] / n
        vector<complex128> Ln(L1.size() + 1, 0.0);
        
        // (2n-1+α) * L_{n-1}(x)
        for (size_t j = 0; j < L1.size(); j++) {
            Ln[j] += (2.0*i - 1.0 + alpha) * L1[j];
        }
        
        // -x * L_{n-1}(x)
        for (size_t j = 0; j < L1.size(); j++) {
            Ln[j + 1] -= L1[j];
        }
        
        // - (n-1+α)L_{n-2}(x)
        for (size_t j = 0; j < L0.size(); j++) {
            Ln[j] -= (i - 1.0 + alpha) * L0[j];
        }
        
        // / n
        for (size_t j = 0; j < Ln.size(); j++) {
            Ln[j] /= i;
        }
        
        L0 = L1;
        L1 = Ln;
    }
    
    return L1;
}

// Polynôme d'Hermite
vector<complex128> generate_hermite_polynomial(int n) {
    if (n == 0) return {1.0};
    if (n == 1) return {2.0, 0.0}; // 2x
    
    vector<complex128> H0 = {1.0};                     // H0(x) = 1
    vector<complex128> H1 = {2.0, 0.0};               // H1(x) = 2x
    
    for (int i = 2; i <= n; i++) {
        // Hn(x) = 2xH_{n-1}(x) - 2(n-1)H_{n-2}(x)
        vector<complex128> Hn(H1.size() + 1, 0.0);
        
        // 2x * H_{n-1}(x)
        for (size_t j = 0; j < H1.size(); j++) {
            Hn[j + 1] += 2.0 * H1[j];
        }
        
        // - 2(n-1)H_{n-2}(x)
        for (size_t j = 0; j < H0.size(); j++) {
            Hn[j] -= 2.0 * (i - 1.0) * H0[j];
        }
        
        H0 = H1;
        H1 = Hn;
    }
    
    return H1;
}

// Polynôme à racines quasi-multiples
vector<complex128> generate_quasi_multiple_polynomial(int n, int num_clusters = 10) {
    random_device rd;
    mt19937 gen(rd());
    uniform_real_distribution<> dis(-2.0, 2.0);
    normal_distribution<> cluster_dis(0.0, 1e-6);
    
    vector<complex128> roots;
    
    // Générer des clusters de racines
    for (int i = 0; i < num_clusters; i++) {
        complex128 center(dis(gen), dis(gen));
        int cluster_size = n / (2 * num_clusters) + (i < n % (2 * num_clusters) ? 1 : 0);
        
        for (int j = 0; j < cluster_size; j++) {
            double real_offset = cluster_dis(gen);
            double imag_offset = cluster_dis(gen);
            roots.push_back(center + complex128(real_offset, imag_offset));
        }
    }
    
    // Ajouter des racines simples pour compléter
    while (roots.size() < n) {
        roots.push_back(complex128(dis(gen), dis(gen)));
    }
    
    // Construire le polynôme à partir des racines
    vector<complex128> poly = {1.0};
    for (const auto& root : roots) {
        vector<complex128> factor = {-root, 1.0}; // (x - root)
        vector<complex128> new_poly(poly.size() + 1, 0.0);
        
        for (size_t i = 0; i < poly.size(); i++) {
            for (size_t j = 0; j < factor.size(); j++) {
                new_poly[i + j] += poly[i] * factor[j];
            }
        }
        
        poly = new_poly;
    }
    
    return poly;
}

// ============================================================================
// Fonctions utilitaires pour les tests
// ============================================================================

// Évaluation d'un polynôme
complex128 evaluate_polynomial(const vector<complex128>& coefficients, complex128 x) {
    complex128 result = 0.0;
    for (int i = coefficients.size() - 1; i >= 0; i--) {
        result = result * x + coefficients[i];
    }
    return result;
}

// Calcul de l'erreur résiduelle maximale
double max_residual_error(const vector<complex128>& coefficients, 
                         const vector<complex128>& roots) {
    double max_error = 0.0;
    for (const auto& root : roots) {
        double error = abs(evaluate_polynomial(coefficients, root));
        if (error > max_error) max_error = error;
    }
    return max_error;
}

// Vérification de la précision des racines
bool verify_roots(const vector<complex128>& coefficients, 
                 const vector<complex128>& roots, 
                 double tolerance = 1e-10) {
    for (const auto& root : roots) {
        if (abs(evaluate_polynomial(coefficients, root)) > tolerance) {
            return false;
        }
    }
    return true;
}

