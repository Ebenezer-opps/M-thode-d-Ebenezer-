void test_polynomial_generation() {
    cout << "Testing polynomial generation..." << endl;
    
    // Test Chebyshev
    auto cheb = generate_chebyshev_polynomial(5);
    assert(cheb.size() == 6);
    cout << "Chebyshev T5: ";
    for (const auto& coef : cheb) cout << coef << " ";
    cout << endl;
    
    // Test Legendre
    auto leg = generate_legendre_polynomial(5);
    assert(leg.size() == 6);
    cout << "Legendre P5: ";
    for (const auto& coef : leg) cout << coef << " ";
    cout << endl;
    
    // Test Laguerre
    auto lag = generate_laguerre_polynomial(5);
    assert(lag.size() == 6);
    cout << "Laguerre L5: ";
    for (const auto& coef : lag) cout << coef << " ";
    cout << endl;
    
    // Test Hermite
    auto her = generate_hermite_polynomial(5);
    assert(her.size() == 6);
    cout << "Hermite H5: ";
    for (const auto& coef : her) cout << coef << " ";
    cout << endl;
    
    // Test quasi-multiple
    auto quasi = generate_quasi_multiple_polynomial(10, 3);
    assert(quasi.size() == 11);
    cout << "Quasi-multiple degree 10: Generation successful" << endl;
    
    cout << "Polynomial generation tests passed!" << endl << endl;
}

void test_aberth_ehrlich_small() {
    cout << "Testing Aberth-Ehrlich on small polynomial..." << endl;
    
    // Polynôme simple: x^2 - 1 = (x-1)(x+1)
    vector<complex128> coefficients = {-1.0, 0.0, 1.0};
    vector<complex128> initial_roots = {complex128(0.5, 0.5), complex128(-0.5, -0.5)};
    
    auto roots = aberth_ehrlich_gpu(coefficients, initial_roots, 1e-10, 20);
    
    // Vérifier que nous avons trouvé les bonnes racines
    assert(roots.size() == 2);
    assert(verify_roots(coefficients, roots, 1e-8));
    
    cout << "Small polynomial test passed! Roots: ";
    for (const auto& root : roots) cout << root << " ";
    cout << endl << endl;
}

void test_clustering() {
    cout << "Testing Schur clustering..." << endl;
    
    // Créer un ensemble de racines avec des clusters
    vector<complex128> roots;
    
    // Cluster 1 autour de (1, 1)
    for (int i = 0; i < 5; i++) {
        roots.push_back(complex128(1.0 + 0.001 * i, 1.0 + 0.001 * i));
    }
    
    // Cluster 2 autour de (-1, -1)
    for (int i = 0; i < 5; i++) {
        roots.push_back(complex128(-1.0 - 0.001 * i, -1.0 - 0.001 * i));
    }
    
    // Racines isolées
    roots.push_back(complex128(5.0, 0.0));
    roots.push_back(complex128(0.0, 5.0));
    roots.push_back(complex128(-5.0, 0.0));
    
    auto clusters = schur_clustering(roots, 0.01);
    
    // Devrait avoir 4 clusters: 2 denses et 2 isolés + 1 isolé?
    assert(clusters.size() >= 4);
    
    cout << "Found " << clusters.size() << " clusters:" << endl;
    for (size_t i = 0; i < clusters.size(); i++) {
        cout << "Cluster " << i << " size: " << clusters[i].size() << endl;
    }
    cout << "Clustering test passed!" << endl << endl;
}

void test_newton_krylov() {
    cout << "Testing Newton-Krylov refinement..." << endl;
    
    // Polynôme: x^2 - 2x + 1 = (x-1)^2
    vector<complex128> coefficients = {1.0, -2.0, 1.0};
    vector<complex128> initial_roots = {complex128(1.1, 0.0), complex128(0.9, 0.0)};
    
    auto refined_roots = newton_krylov_refinement(coefficients, initial_roots, 1e-12, 10);
    
    // Vérifier que nous avons amélioré la précision
    assert(verify_roots(coefficients, refined_roots, 1e-10));
    
    cout << "Newton-Krylov test passed! Refined roots: ";
    for (const auto& root : refined_roots) cout << root << " ";
    cout << endl << endl;
}

// ============================================================================
// Tests de performance
// ============================================================================

void benchmark_polynomial(int degree, const string& poly_type) {
    cout << "Benchmarking " << poly_type << " polynomial of degree " << degree << "..." << endl;
    
    vector<complex128> coefficients;
    
    // Générer le polynôme
    auto start_gen = high_resolution_clock::now();
    
    if (poly_type == "chebyshev") {
        coefficients = generate_chebyshev_polynomial(degree);
    } else if (poly_type == "legendre") {
        coefficients = generate_legendre_polynomial(degree);
    } else if (poly_type == "laguerre") {
        coefficients = generate_laguerre_polynomial(degree);
    } else if (poly_type == "hermite") {
        coefficients = generate_hermite_polynomial(degree);
    } else if (poly_type == "quasi_multiple") {
        coefficients = generate_quasi_multiple_polynomial(degree, 10);
    }
    
    auto end_gen = high_resolution_clock::now();
    auto gen_time = duration_cast<milliseconds>(end_gen - start_gen).count();
    
    // Résoudre le polynôme
    auto start_solve = high_resolution_clock::now();
    auto roots = solve_polynomial_ebenezer(coefficients, degree);
    auto end_solve = high_resolution_clock::now();
    auto solve_time = duration_cast<milliseconds>(end_solve - start_solve).count();
    
    // Vérifier la précision
    double max_error = max_residual_error(coefficients, roots);
    
    cout << "Generation time: " << gen_time << " ms" << endl;
    cout << "Solving time: " << solve_time << " ms" << endl;
    cout << "Max residual error: " << max_error << endl;
    cout << "Benchmark completed!" << endl << endl;
    
    // Sauvegarder les résultats
    ofstream outfile("benchmark_results.csv", ios::app);
    outfile << poly_type << "," << degree << "," << gen_time << "," << solve_time << "," << max_error << endl;
    outfile.close();
}

void run_benchmarks() {
    cout << "Running comprehensive benchmarks..." << endl;
    
    // En-tête du fichier de résultats
    ofstream outfile("benchmark_results.csv");
    outfile << "PolynomialType,Degree,GenerationTime(ms),SolvingTime(ms),MaxResidualError" << endl;
    outfile.close();
    
    // Tests pour différents degrés et types de polynômes
    vector<int> degrees = {10, 100, 1000};
    vector<string> poly_types = {"chebyshev", "legendre", "laguerre", "hermite", "quasi_multiple"};
    
    for (const auto& poly_type : poly_types) {
        for (int degree : degrees) {
            if (degree <= 1000 || poly_type != "quasi_multiple") { // Éviter les gros calculs en test
                benchmark_polynomial(degree, poly_type);
            }
        }
    }
    
    cout << "All benchmarks completed!" << endl;
}

// ============================================================================
// Tests de validation numérique
// ============================================================================

void test_numerical_stability() {
    cout << "Testing numerical stability..." << endl;
    
    // Test avec le polynôme de Wilkinson (mal conditionné)
    int n = 20; // Petit degré pour le test
    vector<complex128> coefficients(n + 1, 0.0);
    coefficients[n] = 1.0;
    
    // Coefficients pour (x-1)(x-2)...(x-20)
    for (int i = 1; i <= n; i++) {
        vector<complex128> new_coeffs(coefficients.size() + 1, 0.0);
        for (size_t j = 0; j < coefficients.size(); j++) {
            new_coeffs[j + 1] += coefficients[j];
            new_coeffs[j] -= i * coefficients[j];
        }
        coefficients = new_coeffs;
    }
    
    auto roots = solve_polynomial_ebenezer(coefficients, n);
    double max_error = max_residual_error(coefficients, roots);
    
    cout << "Wilkinson polynomial (degree " << n << ") max residual error: " << max_error << endl;
    
    // Le polynôme de Wilkinson est très mal conditionné, donc une erreur plus élevée est attendue
    assert(max_error < 1e-5); // Tolérance assouplie pour le polynôme de Wilkinson
    
    cout << "Numerical stability test passed!" << endl << endl;
}

void test_edge_cases() {
    cout << "Testing edge cases..." << endl;
    
    // Polynôme avec racines multiples
    vector<complex128> coefficients = {1.0, -3.0, 3.0, -1.0}; // (x-1)^3
    auto roots = solve_polynomial_ebenezer(coefficients, 3);
    
    // Vérifier que nous avons trouvé une racine triple
    assert(roots.size() == 3);
    double max_error = max_residual_error(coefficients, roots);
    cout << "Triple root polynomial max residual error: " << max_error << endl;
    assert(max_error < 1e-10);
    
    // Polynôme avec coefficients nuls
    vector<complex128> zero_coeffs = {0.0, 0.0, 1.0}; // x^2
    roots = solve_polynomial_ebenezer(zero_coeffs, 2);
    assert(roots.size() == 2);
    max_error = max_residual_error(zero_coeffs, roots);
    cout << "Zero coefficients polynomial max residual error: " << max_error << endl;
    assert(max_error < 1e-10);
    
    cout << "Edge cases test passed!" << endl << endl;
}

